then :

       as_fn_error $? "--without-ucdpath $_ax_xt_conflict" "$LINENO" 5
fi
     _ax_xt_saw_no=:
     _ax_xt_conflict="conflicts with --without-ucdpath" ;; #(
  *) :

     if $_ax_xt_saw_no
then :

       as_fn_error $? "--with-ucdpath $_ax_xt_conflict" "$LINENO" 5

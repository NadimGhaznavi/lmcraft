  done
IFS=$as_save_IFS

fi ;;
esac
fi
GPERF=$ac_cv_prog_GPERF
if test -n "$GPERF"; then
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $GPERF" >&5
printf "%s\n" "$GPERF" >&6; }
else
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
printf "%s\n" "no" >&6; }

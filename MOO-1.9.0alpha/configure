# --(enable|disable)-net
if test "x$silent" = xyes ; then
  moo_net_do_list=false
else
  moo_net_do_list=:
fi
moo_net_do_check=:
moo_net_do_require=false

# Check whether --enable-net was given.
if test ${enable_net+y}
then :
  enableval=$enable_net; ac_save_IFS=$IFS
moo_net_do_list=false
IFS=,
for moo_kwd in ,x $enableval ; do
  IFS=$ac_save_IFS
  case $moo_kwd in #(

    ,x) :
    continue ;; #(

    list) :
    moo_net_do_list=: ;      continue ;; #(

    nowarn) :
    moo_net_do_check=false ; continue ;; #(

    require) :
    moo_net_do_require=: ;  continue ;; #(

    out) :
    moo_d=OUTBOUND_NETWORK; moo_v=OBN_ON ;; #(

    outoff) :
    moo_d=OUTBOUND_NETWORK; moo_v=OBN_OFF ;; #(

    noout) :
    moo_d=OUTBOUND_NETWORK; moo_v=no ;; #(

    no) :
    moo_d=NETWORK_PROTOCOL; moo_v=NP_SINGLE
	      moo_d_NETWORK_STYLE=no
	      moo_d_MPLEX_STYLE=no
	      moo_d_OUTBOUND_NETWORK=no ;; #(

    tcp) :
    moo_d=NETWORK_PROTOCOL; moo_v=NP_TCP ;; #(

    local) :
    moo_d=NETWORK_PROTOCOL; moo_v=NP_LOCAL
              moo_d_OUTBOUND_NETWORK=no ;; #(

    bsd) :
    moo_d=NETWORK_STYLE;    moo_v=NS_BSD ;; #(

    sysv) :
    moo_d=NETWORK_STYLE;    moo_v=NS_SYSV ;; #(

    select) :
    moo_d=MPLEX_STYLE;      moo_v=MP_SELECT ;; #(

    poll) :
    moo_d=MPLEX_STYLE;      moo_v=MP_POLL ;; #(

    fake) :
    moo_d=MPLEX_STYLE;      moo_v=MP_FAKE ;; #(

    '"'*'"') :
    moo_d=DEFAULT_CONNECT_FILE; moo_v="$moo_kwd" ;; #(

    */*) :
    moo_d=DEFAULT_CONNECT_FILE; moo_v="\"$moo_kwd\"" ;; #(

    *[!0-9]*) :
    as_fn_error $? "unknown --enable-net keyword: $moo_kwd" "$LINENO" 5 ;; #(
  *) :
    moo_d=DEFAULT_PORT; moo_v=$moo_kwd ;;
esac
  if eval test \${moo_d_$moo_d+y}
then :
  eval moo_v=\$moo_d_$moo_d
     as_fn_error $? "--enable-net=...,$moo_kwd: $moo_d already set to $moo_v" "$LINENO" 5
fi
  eval "moo_d_$moo_d=\$moo_v"
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: (--enable-net:) $moo_d = $moo_v" >&5
printf "%s\n" "$as_me: (--enable-net:) $moo_d = $moo_v" >&6;}
done
fi



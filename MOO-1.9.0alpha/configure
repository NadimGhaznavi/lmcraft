then :
  enableval=$enable_svf_make; case $enableval in #(
  yes) :
    case $moo_cv_make_is_gnumake in #(
  no) :
    as_fn_error $? "--enable-svf-make requires GNU make" "$LINENO" 5 ;; #(
  *) :
     ;;
esac ;; #(
  *) :
     ;;
esac
else case e in #(
  e) enable_svf_make=$moo_cv_make_is_gnumake ;;
esac
fi


case $with_ucdpath in #(

  yes) :

    as_fn_error $? "--with-ucdpath requires a directory (%path not set)" "$LINENO" 5 ;; #(
  *) :
     ;;
esac
if $moo_xt_do_unicode
then :
  if test "x$enable_unicode" = x
then :
    _ax_xt_l=yes
else case e in #(
  e)   _ax_xt_l=$enable_unicode ;;
esac
fi
else case e in #(
  e) _ax_xt_l=no ;;
esac
fi
while test "$_ax_xt_l" != __done__ ; do
  ac_save_IFS=$IFS
  IFS=,
  _ax_xt_ll=__done__
  for _ax_xt_kwd in $_ax_xt_l ; do
    IFS=$ac_save_IFS
    case $_ax_xt_kwd in #(

      __done__) :

        continue ;; #(

      core|strs|strings) :

        _ax_xt_d=UNICODE_STRINGS
        if eval test \${moo_d_$_ax_xt_d+y}
then :
  continue
else case e in #(
  e) _ax_xt_v=yes ;;
esac
fi ;; #(

      nums|numbers) :

        _ax_xt_d=UNICODE_NUMBERS
        if eval test \${moo_d_$_ax_xt_d+y}
then :
  continue
else case e in #(
  e) _ax_xt_v=yes ;;
esac
fi
        _ax_xt_ll="$_ax_xt_ll,strs" ;; #(

      ids|identifiers) :

        _ax_xt_d=UNICODE_IDENTIFIERS
        if eval test \${moo_d_$_ax_xt_d+y}
then :
  continue
else case e in #(
  e) _ax_xt_v=yes ;;
esac
fi
        _ax_xt_ll="$_ax_xt_ll,strs" ;; #(

      code) :

        _ax_xt_ll="$_ax_xt_ll,ids,nums"
        continue ;; #(

      all) :

        _ax_xt_ll="$_ax_xt_ll,code"
        continue ;; #(

      yes) :

        _ax_xt_ll="__done__,strs"
        continue ;; #(

      no) :

        _ax_xt_ll=__done__
        moo_d_UNICODE_STRINGS=no
        moo_d_UNICODE_NUMBERS=no
        moo_d_UNICODE_IDENTIFIERS=no
        break ;; #(
  *) :

      as_fn_error $? "unknown --enable-unicode keyword: $_ax_xt_kwd" "$LINENO" 5 ;;
esac
    eval "moo_d_$_ax_xt_d=\$_ax_xt_v"
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: (--enable-unicode:) $_ax_xt_d = $_ax_xt_v" >&5
printf "%s\n" "$as_me: (--enable-unicode:) $_ax_xt_d = $_ax_xt_v" >&6;}
  done
  _ax_xt_l=$_ax_xt_ll
done

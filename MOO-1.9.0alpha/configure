  printf %s "(cached) " >&6
fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $moo_git_cv_repo" >&5
printf "%s\n" "$moo_git_cv_repo" >&6; }
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking how to do git hash" >&5
printf %s "checking how to do git hash... " >&6; }
if test ${moo_prog_cv_sha1git_hash+y}
then :
  printf %s "(cached) " >&6
else case e in #(
  e)
if test "$moo_prog_cv_git" = yes ; then
  moo_prog_cv_sha1git_hash=git
elif test `printf "blob 0\000" | shasum  | tr -d ' -' 2<&1` = "$moo_git_zerohash"; then
  moo_prog_cv_sha1git_hash=shasum
elif test `printf "blob 0\000" | sha1sum | tr -d ' -' 2<&1` = "$moo_git_zerohash"; then
  moo_prog_cv_sha1git_hash=sha1sum
else
  moo_prog_cv_sha1git_hash=no
fi ;;
esac
fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $moo_prog_cv_sha1git_hash" >&5
printf "%s\n" "$moo_prog_cv_sha1git_hash" >&6; }
case $moo_prog_cv_sha1git_hash in #(

  git) :

    moo_git_hash_body='git hash-object "$1"'
 ;; #(

  shasum | sha1sum) :

    moo_git_hash_body='_moo_a=`cat $1`
    as_fn_arith  1 + ${#_moo_a}  && _moo_b=$as_val
    printf "blob %d\000%s\n" $_moo_b "${_moo_a}" | '$moo_prog_cv_sha1git_hash' | tr -d '"' -'"
 ;; #(
  *) :

    moo_git_hash_body='as_fn_error $? "no sha1 hash avaiable" "$LINENO" 5'
 ;;
esac

moo_init_lastck=
if test -f "$srcdir/version.fixed" ; then
  if test "$moo_prog_cv_sha1git_hash" != no &&
     test -f "$srcdir/MANIFEST"; then
  { moo_init_lastck=$moo_init_lastck`cat`'
'; } <<\_MOO_END_ADDINIT

moo_trhash_200 () {
  moo_dfile=$tmp/moo_vdiff.tmp
  rm -f "$moo_dfile"
  for moo_f in `cat "$ac_top_srcdir/MANIFEST"` ; do
    case $moo_f in #(

    keywords.c | parser.c | y.tab.h | configure) :

      continue
     ;; #(
  *) :

      moo_fhash_200 "$ac_top_srcdir/$moo_f" >>"$moo_dfile"
   ;;
esac
  done
  moo_fhash_200 "$moo_dfile"
  rm -f "$moo_dfile"
}
_MOO_END_ADDINIT

  fi
elif test "$moo_git_cv_repo" = yes ; then
  { moo_init_lastck=$moo_init_lastck`cat`'
'; } <<\_MOO_END_ADDINIT

moo_trhash_200 () {
  moo_dfile=$tmp/moo_vdiff.tmp
  rm -f "$moo_dfile"
  (cd $ac_top_srcdir ; git diff-index --no-abbrev --no-renames HEAD ) | {
    moo_changed=false
    while : ; do
      while read _ _ _ moo_hash moo_UMAD moo_file ; do
	moo_changed=:
	case $moo_UMAD in #(

          U) :

            # unfinished merge; this make is destined to fail
            printf "?unmerged?"
	    break 2
	     ;; #(

          D) :

            # deleted file; no contents to hash
	    printf "%s\n" "|$moo_file| deleted" >>"$moo_dfile"
           ;; #(
  *) :

            if test "$moo_hash" = 0000000000000000000000000000000000000000 ; then
    	      # not yet hashed; need to do it ourselves
	      moo_fhash_200 "$srcdir/$moo_file" >>"$moo_dfile"
	    else
	      printf "%s\n" "$moo_hash" >>"$moo_dfile"
	    fi
         ;;
esac
      done
      if $moo_changed ; then
	moo_fhash_200 "$moo_dfile"
      fi
      break
    done
  }
  rm -f "$moo_dfile"
}
_MOO_END_ADDINIT

fi
if test "x$moo_init_lastck" != x ; then
  moo_init_lastck="
moo_fhash_200 () {
  $moo_git_hash_body
}$moo_init_lastck"
  case $enable_svf_diff in #(
  yex) :
    enable_svf_diff=yes ;; #(
  *) :
     ;;
esac
else
  case $enable_svf_diff in #(
  yex) :
    enable_svf_diff=? ;; #(
  yes) :
    as_fn_error $? "enable-svf-diff=yes requires git repository or MANIFEST file" "$LINENO" 5 ;; #(
  *) :
     ;;
esac
fi
{ moo_init_lastck=$moo_init_lastck`cat`'
'; } <<\_MOO_END_ADDINIT

moo_write_lastck () {
  moo_UFIRST=1
  moo_UHASH1=
  moo_VCS=unknown
  moo_do_version_from_git=:
  if test -f "$srcdir/version.fixed"; then
    moo_do_version_from_git=false
    moo_VCS=release
  . "$srcdir/version.fixed" >/dev/null 2>&1
  fi
  if test "x$VERSION_EXT" = x; then
    moo_EXT0=$moo_EXT
  else
    moo_EXT0=$VERSION_EXT
  fi
  moo_no_write=yes
  if test -f ./version.lastck; then
    . ./version.lastck >/dev/null 2>&1
  fi
  moo_EXT=$moo_EXT0

  # write draft of new version.lastck
  moo_vsrc_tmp=$tmp/moo_vsrc.tmp
  rm -f "$moo_vsrc_tmp"
  cat >"$moo_vsrc_tmp" <<_MOO_END
#!$SHELL
##### generated file; DO NOT EDIT #####
_MOO_END
  if $moo_do_version_from_git; then
    moo_gdesc=`git describe --tags --match "v[0-9]*"`
  # extract (MAJOR).(MINOR).(RELEASE)(EXT)-(CCOUNT) from git describe
  moo_ccount=`expr "X$moo_gdesc" : 'Xv[0-9][0-9]*[.][0-9][0-9]*[.][0-9][0-9]*[^-]*-\([0-9][0-9]*\)'`
  moo_RELEASE=`expr "X$moo_gdesc" : 'Xv[0-9][0-9]*[.][0-9][0-9]*[.]\([0-9][0-9]*\)'`
  moo_EXT=`expr "X$moo_gdesc" : 'Xv[0-9][0-9]*[.][0-9][0-9]*[.][0-9][0-9]*\([^-]*\)'`

  if test "x$moo_RELEASE" = x ; then
      # messed-up repo
      as_fn_error $? "cannot parse version tag '$moo_gdesc'" "$LINENO" 5
  fi
  moo_MINOR=`expr "X$moo_gdesc" : 'Xv[0-9][0-9]*[.]\([0-9][0-9]*\)'`
  moo_MAJOR=`expr "X$moo_gdesc" : 'Xv\([0-9][0-9]*\)'`

  moo_PV=$moo_MAJOR
printf "%s='%s'\n" "moo_MAJOR" "$moo_PV" >>"$moo_vsrc_tmp"
  moo_PV=$moo_MINOR
printf "%s='%s'\n" "moo_MINOR" "$moo_PV" >>"$moo_vsrc_tmp"
  moo_PV=$moo_RELEASE
printf "%s='%s'\n" "moo_RELEASE" "$moo_PV" >>"$moo_vsrc_tmp"
  if test "x$moo_ccount" != x; then
      moo_EXT=$moo_EXT+$moo_ccount
  fi
    if test "x$enable_svf_source" = "xyes" ; then
      moo_VCS=git
  moo_PV=$moo_VCS
printf "%s='%s'\n" "moo_VCS" "$moo_PV" >>"$moo_vsrc_tmp"

  # check for git upgrade
  moo_gversion=`git --version`
  moo_gversion=`expr "X$moo_gversion" : 'Xgit version \(.*\)'`
  moo_DEFSRC='DEF(vcs_version,"'$moo_gversion'")'

  # include commit id
  moo_DEFSRC=$moo_DEFSRC' DEF(commit,"'`git rev-list -1 HEAD`'")'

  if test "x$moo_gdesc" != x ; then
    moo_DEFSRC=$moo_DEFSRC' DEF(desc,"'$moo_gdesc'")'
  fi
  moo_PV=$moo_DEFSRC
printf "%s='%s'\n" "moo_DEFSRC" "$moo_PV" >>"$moo_vsrc_tmp"
    fi
  fi
  moo_UHASH=
  case $enable_svf_diff in #(
  '!') :
     ;; #(
  no|'?') :

     moo_EXT=$moo_EXT?  ;; #(
  yes) :

    moo_UHASH=`moo_trhash_200`
    test "x$moo_UHASH_RELEASE" != x &&
      test "x$moo_UHASH" = "x$moo_UHASH_RELEASE" &&
      moo_UHASH=
     ;; #(
  *) :
     ;;
esac
  moo_UCUR=
  if test "x$moo_UHASH" != x; then
    while : ; do

    moo_UCUR=$moo_UFIRST
  while eval moo_UH=\$moo_UHASH$moo_UCUR
    test "x$moo_UH" != x
  do
    test "$moo_UH" = "$moo_UHASH" && break 2
    as_fn_arith $moo_UCUR + 1 && moo_UCUR=$as_val
  done

      eval "moo_UHASH$moo_UCUR=\$moo_UHASH"
      as_fn_arith $moo_UCUR - 5 && moo_U=$as_val
      if test "$moo_U" -gt "$moo_UFIRST" ; then
        as_fn_arith $moo_UFIRST + 1 && moo_UFIRST=$as_val
      fi
      break
    done
  fi
  if test "x$moo_UCUR" != x || test "$moo_UFIRST" -ne 1 || test "x$moo_UHASH1" != x ; then
    moo_PV=$moo_UFIRST
printf "%s='%s'\n" "moo_UFIRST" "$moo_PV" >>"$moo_vsrc_tmp"

    moo_u=$moo_UFIRST
  while eval moo_uh_200=\$moo_UHASH$moo_u
    test "x$moo_uh_200" != x
  do
    eval moo_PV=\$moo_UHASH$moo_u
printf "%s='%s'\n" "moo_UHASH$moo_u" "$moo_PV" >>"$moo_vsrc_tmp"
    as_fn_arith $moo_u + 1 && moo_u=$as_val
  done

    eval "moo_UHASH$moo_u="
    eval moo_PV=\$moo_UHASH$moo_u
printf "%s='%s'\n" "moo_UHASH$moo_u" "$moo_PV" >>"$moo_vsrc_tmp"
    moo_PV=$moo_UCUR
printf "%s='%s'\n" "moo_UCUR" "$moo_PV" >>"$moo_vsrc_tmp"
  fi
  if test "x$moo_UCUR" != x ; then
    moo_EXT=${moo_EXT}?$moo_UCUR
  fi
  moo_PV=$moo_EXT
printf "%s='%s'\n" "moo_EXT" "$moo_PV" >>"$moo_vsrc_tmp"

  # produce contents of version_src.h
  cat >>"$moo_vsrc_tmp" <<\_MOO_END
if test x"$moo_no_write" = x ; then
  cat <<\_VSRC_END
_MOO_END
  if test "x$moo_RELEASE" != x ; then
    cat >>"$moo_vsrc_tmp" <<_MOO_END
#define VERSION_RELEASE $moo_RELEASE
#define VERSION_MINOR $moo_MINOR
#define VERSION_MAJOR $moo_MAJOR
_MOO_END
  fi
  if test "x$enable_svf_source" = "xyes" ; then
    cat >>"$moo_vsrc_tmp" <<_MOO_END
#define VERSION_SOURCE(DEF) DEF(vcs,"$moo_VCS") $moo_DEFSRC
#define VERSION_CONFIG(DEF) DEF(ac,"2.72") DEF(args,"$ac_cs_config")
_MOO_END
  fi
  _moo_xts=`printf ' '$moo_xt_op'("%s")' $moo_xt_active_xts`
  cat >>"$moo_vsrc_tmp" <<_MOO_END
#define VERSION_EXT "$moo_EXT"
#define VERSION_XTLIST($moo_xt_op) $_moo_xts
_VSRC_END
fi
_MOO_END

  # replace if different
  moo_file=version.lastck
  if diff "$moo_file" "$moo_vsrc_tmp" >/dev/null 2>&1; then
    :
  else
    chmod -w+x "$moo_vsrc_tmp"
    rm -f "$moo_file"
    mv "$moo_vsrc_tmp" "$moo_file" \
      || as_fn_error $? "could not create $moo_file" "$LINENO" 5
    if test "x$moo_RELEASE" = x; then
      { printf "%s\n" "$as_me:${as_lineno-$LINENO}: version ext = $moo_EXT" >&5
printf "%s\n" "$as_me: version ext = $moo_EXT" >&6;}
    else
      { printf "%s\n" "$as_me:${as_lineno-$LINENO}: version = $moo_MAJOR.$moo_MINOR.$moo_RELEASE$moo_EXT" >&5
printf "%s\n" "$as_me: version = $moo_MAJOR.$moo_MINOR.$moo_RELEASE$moo_EXT" >&6;}
    fi
  fi
}
_MOO_END_ADDINIT

moo_init_lastck="
VERSION_EXT=$VERSION_EXT
enable_svf_source=$enable_svf_source
enable_svf_diff=$enable_svf_diff
moo_xt_active_xts=\"$moo_xt_active_xts\"
moo_xt_op=DEF
while : ; do
  case \$moo_xt_active_xts' ' in #(

    *' '\$moo_xt_op' '*) :

      moo_xt_op=\${moo_xt_op}x
      continue ;; #(
  *) :
     ;;
esac
  break
done

"$moo_init_lastck

cat >confcache <<\_ACEOF
# This file is a shell script that caches the results of configure
# tests run on this system so they can be shared between configure
# scripts and configure runs, see configure's option --config-cache.
# It is not useful on other systems.  If it contains results you don't
# want to keep, you may remove or edit it.
#
# config.status only pays attention to the cache file if you give it
# the --recheck option to rerun configure.
#
# 'ac_cv_env_foo' variables (set or unset) will be overridden when
# loading this file, other *unset* 'ac_cv_foo' will be assigned the
# following values.

_ACEOF

# The following way of writing the cache mishandles newlines in values,
# but we know of no workaround that is simple, portable, and efficient.
# So, we kill variables containing newlines.
# Ultrix sh set writes to stderr and can't be redirected directly,
# and sets the high bit in the cache file unless we assign to the vars.
(
  for ac_var in `(set) 2>&1 | sed -n 's/^\([a-zA-Z_][a-zA-Z0-9_]*\)=.*/\1/p'`; do
    eval ac_val=\$$ac_var
    case $ac_val in #(
    *${as_nl}*)
      case $ac_var in #(
      *_cv_*) { printf "%s\n" "$as_me:${as_lineno-$LINENO}: WARNING: cache variable $ac_var contains a newline" >&5
printf "%s\n" "$as_me: WARNING: cache variable $ac_var contains a newline" >&2;} ;;
      esac
      case $ac_var in #(
      _ | IFS | as_nl) ;; #(
      BASH_ARGV | BASH_SOURCE) eval $ac_var= ;; #(
      *) { eval $ac_var=; unset $ac_var;} ;;
      esac ;;
    esac
  done

  (set) 2>&1 |
    case $as_nl`(ac_space=' '; set) 2>&1` in #(
    *${as_nl}ac_space=\ *)
      # 'set' does not quote correctly, so add quotes: double-quote
      # substitution turns \\\\ into \\, and sed turns \\ into \.
      sed -n \
	"s/'/'\\\\''/g;
	  s/^\\([_$as_cr_alnum]*_cv_[_$as_cr_alnum]*\\)=\\(.*\\)/\\1='\\2'/p"
      ;; #(
    *)
      # 'set' quotes correctly as required by POSIX, so do not add quotes.
      sed -n "/^[_$as_cr_alnum]*_cv_[_$as_cr_alnum]*=/p"
      ;;
    esac |
    sort
) |
  sed '
     /^ac_cv_env_/b end
     t clear
     :clear
     s/^\([^=]*\)=\(.*[{}].*\)$/test ${\1+y} || &/
     t end
     s/^\([^=]*\)=\(.*\)$/\1=${\1=\2}/
     :end' >>confcache
if diff "$cache_file" confcache >/dev/null 2>&1; then :; else
  if test -w "$cache_file"; then
    if test "x$cache_file" != "x/dev/null"; then
      { printf "%s\n" "$as_me:${as_lineno-$LINENO}: updating cache $cache_file" >&5
printf "%s\n" "$as_me: updating cache $cache_file" >&6;}
      if test ! -f "$cache_file" || test -h "$cache_file"; then
	cat confcache >"$cache_file"
      else
        case $cache_file in #(
        */* | ?:*)
	  mv -f confcache "$cache_file"$$ &&
	  mv -f "$cache_file"$$ "$cache_file" ;; #(
        *)
	  mv -f confcache "$cache_file" ;;
	esac
      fi
    fi
  else
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: not updating unwritable cache $cache_file" >&5
printf "%s\n" "$as_me: not updating unwritable cache $cache_file" >&6;}
  fi
fi
rm -f confcache

test "x$prefix" = xNONE && prefix=$ac_default_prefix
# Let make expand exec_prefix.
test "x$exec_prefix" = xNONE && exec_prefix='${prefix}'

DEFS=-DHAVE_CONFIG_H

ac_libobjs=
ac_ltlibobjs=
U=
for ac_i in : $LIBOBJS; do test "x$ac_i" = x: && continue
  # 1. Remove the extension, and $U if already installed.
  ac_script='s/\$U\././;s/\.o$//;s/\.obj$//'
  ac_i=`printf "%s\n" "$ac_i" | sed "$ac_script"`
  # 2. Prepend LIBOBJDIR.  When used with automake>=1.10 LIBOBJDIR
  #    will be set to the directory where LIBOBJS objects are built.
  as_fn_append ac_libobjs " \${LIBOBJDIR}$ac_i\$U.$ac_objext"
  as_fn_append ac_ltlibobjs " \${LIBOBJDIR}$ac_i"'$U.lo'
done
LIBOBJS=$ac_libobjs

LTLIBOBJS=$ac_ltlibobjs



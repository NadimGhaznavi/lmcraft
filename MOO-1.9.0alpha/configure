then :
  enableval=$enable_waifs; case $enableval in #(

   no) :

     _ax_xt_saw_no=:
     _ax_xt_conflict="conflicts with --disable-waifs" ;; #(
  *) :

     moo_xt_do_waifs=:
     _ax_xt_conflict="conflicts with --enable-waifs" ;;
esac
fi

if $moo_xt_do_waifs
then :
  if test "x$enable_waifs" = x
then :
    _ax_xt_l=yes
else case e in #(
  e)   _ax_xt_l=$enable_waifs ;;
esac
fi
else case e in #(
  e) _ax_xt_l=no ;;
esac
fi
while test "$_ax_xt_l" != __done__ ; do
  ac_save_IFS=$IFS
  IFS=,
  _ax_xt_ll=__done__
  for _ax_xt_kwd in $_ax_xt_l ; do
    IFS=$ac_save_IFS
    case $_ax_xt_kwd in #(

      __done__) :

        continue ;; #(

      core) :

        _ax_xt_d=WAIF_CORE
        if eval test \${moo_d_$_ax_xt_d+y}
then :
  continue
else case e in #(
  e) _ax_xt_v=yes ;;
esac
fi ;; #(

      dict) :

        _ax_xt_d=WAIF_DICT
        if eval test \${moo_d_$_ax_xt_d+y}
then :
  continue
else case e in #(
  e) _ax_xt_v=yes ;;
esac
fi
        _ax_xt_ll="$_ax_xt_ll,core" ;; #(

      all) :

        _ax_xt_ll="$_ax_xt_ll,dict"
        continue ;; #(

      yes) :

        _ax_xt_ll="__done__,dict"
        continue ;; #(

      no) :

        _ax_xt_ll=__done__
        moo_d_WAIF_CORE=no
        moo_d_WAIF_DICT=no
        break ;; #(
  *) :

      as_fn_error $? "unknown --enable-waifs keyword: $_ax_xt_kwd" "$LINENO" 5 ;;
esac
    eval "moo_d_$_ax_xt_d=\$_ax_xt_v"
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: (--enable-waifs:) $_ax_xt_d = $_ax_xt_v" >&5
printf "%s\n" "$as_me: (--enable-waifs:) $_ax_xt_d = $_ax_xt_v" >&6;}
  done
  _ax_xt_l=$_ax_xt_ll
done
#
# ------------- end of extension arguments


# --(enable|disable)-prop-protect
#   a less insane way of dealing with IGNORE_PROP_PROTECTED
# Check whether --enable-prop-protect was given.
if test ${enable_prop_protect+y}
then :
  enableval=$enable_prop_protect; case $enableval in #(
  no) :
    moo_d_IGNORE_PROP_PROTECTED=yes ;; #(
  *) :
    moo_d_IGNORE_PROP_PROTECTED=no ;;
esac
fi



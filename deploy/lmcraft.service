[Unit]
Description=LMCraft LambdaMOO world server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=lmcraft
Group=lmcraft
WorkingDirectory=/opt/prod/lmcraft
EnvironmentFile=/opt/prod/lmcraft/conf/lmcraft.env
ExecStart=/opt/prod/lmcraft/scripts/run-moo
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=mixed
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/prod/lmcraft/data
CapabilityBoundingSet=
RestrictSUIDSGID=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
